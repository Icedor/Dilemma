Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
	RewriteRule ^(?:\.(?!well-known/)|app/|bin/|database/|docs/|tests/|var/) - [F,END]
	RewriteRule ^assets/(?:app\.js|style\.css|people\.svg|favicon\.svg)$ - [END]
	RewriteRule ^index\.php$ - [END]
	RewriteRule ^ index.php [END]
</IfModule>

<FilesMatch "(?i)^(?:\..*|.*\.(?:env|log|sql|bak|zip|md))$">
	Require all denied
</FilesMatch>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "no-referrer"
</IfModule>
