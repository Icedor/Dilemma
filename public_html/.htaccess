Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
	RewriteRule ^(?:\.(?!well-known/)|app/|bin/|database/|docs/|tests/|var/) - [F,END]
	RewriteRule ^assets/(?:app\.js|clipboard\.js|avatar\.js|language\.js|pwa\.js|style\.css|gradient-(?:yellow-v2|red)\.webp|favicon\.svg|share-opinion\.png|share-change-your-mind\.jpg|icon-(?:192|512|maskable)\.png|badge\.png)$ - [END]
	RewriteRule ^(?:manifest\.webmanifest|sw\.js|offline\.html)$ - [END]
	RewriteRule ^index\.php$ - [END]
	RewriteRule ^ index.php [END]
</IfModule>

<FilesMatch "(?i)^(?:\..*|.*\.(?:env|log|sql|bak|zip|md))$">
	Require all denied
</FilesMatch>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "no-referrer"
	<FilesMatch "\.(?:css|png|jpg|svg|webp)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
	<FilesMatch "^(?:app|clipboard|avatar|language|pwa)\.js$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
	<Files "sw.js">
		Header set Cache-Control "no-cache"
	</Files>
</IfModule>

<IfModule mod_mime.c>
	AddType application/manifest+json .webmanifest
	AddType text/javascript .js
</IfModule>
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
